# PostgreSQL Connection Configuration
# Copy this file to .env and update with your actual credentials if needed

# Database User (default: postgres)
DB_USER=postgres

# Database Password (change this if different)
DB_PASSWORD=123

# Database Host (default: localhost)
DB_HOST=localhost

# Database Port (default: 5432)
DB_PORT=5432

# Database Name (default: chicken_diagnoses)
DB_NAME=chicken_diagnoses

# Flask Secret Key (change this in production!)
SECRET_KEY=dev-secret-key-change-me

# ── Application ────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here

# ── Database (PostgreSQL) ─────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chicken_diagnoses
# Optional: set DATABASE_URL to override the components above
# (e.g. a managed database in production)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Email / SMTP ──────────────────────────────────────────────
# For Gmail: use an App Password (not your main password)
# Enable 2FA → Google Account → Security → App Passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# ── Google OAuth / OIDC ───────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# ── Session cookie ────────────────────────────────────────────
# Set to true in production (HTTPS only)
SESSION_COOKIE_SECURE=false

# ── Misc ──────────────────────────────────────────────────────
RESET_DB=0

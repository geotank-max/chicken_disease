msgstr "បន្ទាប់"

msgid "Back"
msgstr "ថយក្រោយ"

msgid "Select Symptoms"
msgstr "ជ្រើសរើសរោគសញ្ញា"

msgid "Please select at least one symptom."
msgstr "សូមជ្រើសរើសរោគសញ្ញាយ៉ាងហោចណាស់មួយ។"

msgid "Please select symptoms before running analysis."
msgstr "សូមជ្រើសរើសរោគសញ្ញាមុនពេលវិភាគ។"

msgid "Diagnosis Results"
msgstr "លទ្ធផលវិភាគ"

msgid "Save Case"
msgstr "រក្សាទុកករណី"

msgid "Case saved successfully."
msgstr "ករណីត្រូវបានរក្សាទុកដោយជោគជ័យ។"

# --- Case Status ---
msgid "Pending Review"
msgstr "រង់ចាំពិនិត្យ"

msgid "Confirmed"
msgstr "បានបញ្ជាក់"

msgid "Rejected"
msgstr "បានបដិសេធ"

# --- Vet Directory ---
msgid "Find Nearest Vet"
msgstr "រកវេជ្ជបណ្ឌិតសត្វជិតបំផុត"

msgid "Escalate to Doctor"
msgstr "បញ្ជូនទៅវេជ្ជបណ្ឌិត"

msgid "Province"
msgstr "ខេត្ត"

msgid "Phone"
msgstr "ទូរស័ព្ទ"

msgid "Address"
msgstr "អាសយដ្ឋាន"

msgid "Distance"
msgstr "ចម្ងាយ"

msgid "No vets found in your area."
msgstr "មិនមានវេជ្ជបណ្ឌិតសត្វនៅក្នុងតំបន់របស់អ្នកទេ។"

msgid "Case escalated successfully."
msgstr "ករណីត្រូវបានបញ្ជូនដោយជោគជ័យ។"


msgid "Overview"
msgstr "ទិដ្ឋភាពទូទៅ"

msgid "Diagnosis"
msgstr "ការវិភាគ"

msgid "Knowledge Base"
msgstr "មូលដ្ឋានចំណេះដឹង"

msgid "System"
msgstr "ប្រព័ន្ធ"

msgid "Account"
msgstr "គណនី"

msgid "Access"
msgstr "ការចូលប្រើ"

msgid "Search symptoms..."
msgstr "ស្វែងរករោគសញ្ញា..."

msgid "All"
msgstr "ទាំងអស់"

msgid "Other"
msgstr "ផ្សេងៗ"

msgid "Confidence"
msgstr "កម្រិតទំនុកចិត្ត"

msgid "Treatment"
msgstr "ការព្យាបាល"

msgid "Prevention"
msgstr "ការបង្ការ"

msgid "Severity"
msgstr "កម្រិតធ្ងន់ធ្ងរ"

msgid "Contagious"
msgstr "ឆ្លង"

msgid "Yes"
msgstr "បាទ/ចាស"

msgid "No"
msgstr "ទេ"

msgid "You are offline. Diagnosis is available using cached data."
msgstr "អ្នកគ្មានអ៊ីនធឺណិត។ ការវិភាគអាចប្រើបានដោយប្រើទិន្នន័យដែលបានរក្សាទុក។"

# --- Additional flash messages ---
msgid "Review saved successfully."
msgstr "ការពិនិត្យត្រូវបានរក្សាទុក។"

msgid "Could not submit review."
msgstr "មិនអាចដាក់ស្នើការពិនិត្យបានទេ។"

msgid "You have already submitted feedback."
msgstr "អ្នកបានផ្តល់មតិប្រតិកម្មរួចហើយ។"

msgid "Please select a rating."
msgstr "សូមជ្រើសរើសពិន្ទុវាយតម្លៃ។"

msgid "Thank you for your feedback!"
msgstr "សូមអរគុណសម្រាប់មតិប្រតិកម្មរបស់អ្នក!"

msgid "Could not generate PDF. Please use the print function."
msgstr "មិនអាចបង្កើត PDF បានទេ។ សូមប្រើមុខងារបោះពុម្ព។"

msgid "Category updated."
msgstr "ប្រភេទត្រូវបានកែប្រែ។"

msgid "Category deleted."
msgstr "ប្រភេទត្រូវបានលុប។"

msgid "Symptom updated."
msgstr "រោគសញ្ញាត្រូវបានកែប្រែ។"

msgid "Symptom deleted."
msgstr "រោគសញ្ញាត្រូវបានលុប។"

msgid "Disease updated."
msgstr "ជំងឺត្រូវបានកែប្រែ។"

msgid "Disease deleted."
msgstr "ជំងឺត្រូវបានលុប។"

msgid "Rule updated."
msgstr "វិធានត្រូវបានកែប្រែ។"

msgid "Rule deleted."
msgstr "វិធានត្រូវបានលុប។"

# --- Vet escalation ---
msgid "You cannot escalate this case."
msgstr "អ្នកមិនអាចបញ្ជូនករណីនេះបានទេ។"

msgid "Case escalated to you"
msgstr "ករណីត្រូវបានបញ្ជូនមកអ្នក"

msgid "Send this case to a veterinarian for expert review. They will be notified and can review your diagnosis."
msgstr "បញ្ជូនករណីនេះទៅវេជ្ជបណ្ឌិតសត្វសម្រាប់ការពិនិត្យ។ ពួកគេនឹងទទួលបានការជូនដំណឹង។"

msgid "Call"
msgstr "ទូរស័ព្ទ"

msgid "Search"
msgstr "ស្វែងរក"
